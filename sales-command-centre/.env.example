# Never commit this file. Copy .env.example to .env and fill in only what you use.
# Every value is optional — without them the app still runs with native Mac dialling,
# the local voice console, drafts, and the offline agent fallback.

# --- Dashboard protection (recommended) -------------------------------------
# If set, the dashboard asks for this token once per browser (HttpOnly cookie).
DR53_ACCESS_TOKEN=

# HMAC key for session cookies. If empty, a random one is generated into
# data/.session-secret (mode 600) on first run.
DR53_SESSION_SECRET=

# --- Local AI (free, private) ------------------------------------------------
# Local-only safety mode: real provider calls and automated SMS/WhatsApp sending are blocked.
# Set to false only when you intentionally enable and test a real provider integration.
DR53_LOCAL_ONLY=true
# Default provider is Ollama at http://127.0.0.1:11434 with model qwen2.5:3b.
# No env needed — install Ollama, run `ollama serve`, then `ollama pull qwen2.5:3b`.

# --- Optional cloud LLM providers (OpenAI-compatible) ------------------------
# Only used if you add a provider in Settings. Keys stay on the backend.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# --- AI voice calls (real phone calls where the AI speaks) -------------------
# Requires a paid ElevenLabs ConvAI agent connected to a Twilio phone number.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# --- SMS / WhatsApp via Twilio ------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# or a Messaging Service instead of a from-number:
# TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=

# HMAC signing secret generated for the ElevenLabs webhook. The endpoint verifies
# the ElevenLabs-Signature header and rejects requests if this secret is missing.
DR53_WEBHOOK_SECRET=

# Port override (default 3053). The app always binds to 127.0.0.1 only.
# PORT=3053
